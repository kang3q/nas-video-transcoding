# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 커밋되지 않습니다.
#
# 텔레그램 봇 토큰. BotFather 에서 발급합니다. 비워두면 알림이 꺼집니다.
NVT2_TELEGRAM_TOKEN=
# 알림을 받을 대화 ID. 봇에게 아무 메시지나 보낸 뒤
#   curl -s "https://api.telegram.org/bot<토큰>/getUpdates" | grep -o '"id":[0-9-]*'
# 로 확인할 수 있습니다.
NVT2_TELEGRAM_CHAT_ID=
# 알림에 넣을 웹 주소. 없으면 링크 없이 글만 갑니다.
NVT2_PUBLIC_URL=http://192.168.0.10:8080
